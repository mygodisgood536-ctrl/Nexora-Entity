{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "buildCommand": "cd packages/web && next build && cd ../.. && node scripts/copy-standalone-assets.mjs",
    "installCommand": "npm install --include=optional --no-audit --no-fund",
    "outputDirectory": "packages/web/.next/standalone/packages/web",
    "github": {
        "silent": true
    },
    "headers": [
        {
            "source": "/media/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        },
        {
            "source": "/e/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ]
}